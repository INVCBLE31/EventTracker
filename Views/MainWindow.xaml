<Window x:Class="EventTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EventTracker.ViewModels"
        xmlns:conv="clr-namespace:EventTracker.Converters"
        xmlns:models="clr-namespace:EventTracker.Models"
        Title="EventTracker" Height="800" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:StringToColorConverter x:Key="StrToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:StringEqualToVisibilityConverter x:Key="StrEqToVis"/>
        <conv:PercentageToWidthConverter x:Key="PctToWidth"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>
    </Window.Resources>

    <Border CornerRadius="12" Background="#080C14"
            BorderBrush="#1E3054" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ========== TITLE BAR ========== -->
            <Border Grid.Row="0" Background="#0D1320"
                    BorderBrush="#1E3054" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="#1D4ED8"
                                CornerRadius="6" Margin="0,0,10,0">
                            <TextBlock Text="ET" FontSize="11" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock Text="EventTracker" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#F1F5F9" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <Border Background="#1D3461" CornerRadius="4"
                                Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold"
                                       Foreground="#60A5FA" FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Nav -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Margin="4,0"
                                Command="{Binding ShowTimelineCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="{Binding LblTimeline}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="4,0"
                                Command="{Binding ShowDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◈" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="{Binding LblDashboard}"/>
                            </StackPanel>
                        </Button>
                        <!-- Noise Filter / Process activity button -->
                        <Button Style="{StaticResource GhostButton}" Margin="4,0"
                                Command="{Binding ShowNoiseFilterCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔇" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="{Binding LblNoiseFilter}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="4,0"
                                Command="{Binding ExportLogsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↗" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="{Binding LblExport}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Window controls + language toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalEvents, StringFormat='{}{0:N0} events'}"
                                   FontSize="11" Foreground="#475569"
                                   FontFamily="Consolas" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <!-- Language button -->
                        <Button Width="36" Height="26" Margin="2,0"
                                Command="{Binding ToggleLanguageCommand}"
                                ToolTip="Switch language / Сменить язык">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1E3054"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="#2D4A7A"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5" Padding="4,2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2D4A7A"/>
                                                        <Setter Property="Foreground" Value="#60A5FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding CurrentLanguage}" FontSize="11" FontWeight="Bold"
                                       Foreground="#60A5FA" FontFamily="Consolas"/>
                        </Button>
                        <Button Width="28" Height="28" Margin="2,0"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource GhostButton}" Padding="0">
                            <TextBlock Text="—" FontSize="12" Foreground="#94A3B8"/>
                        </Button>
                        <Button Width="28" Height="28" Margin="2,0"
                                Click="MaximizeButton_Click"
                                Style="{StaticResource GhostButton}" Padding="0">
                            <TextBlock Text="⬜" FontSize="10" Foreground="#94A3B8"/>
                        </Button>
                        <Button Width="28" Height="28" Margin="2,0"
                                Click="CloseButton_Click"
                                Style="{StaticResource GhostButton}" Padding="0">
                            <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== SEARCH BAR ========== -->
            <Border Grid.Row="1" Background="#0A1020"
                    BorderBrush="#1E3054" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search input -->
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="⌕" FontSize="18" Foreground="#3B82F6"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding LblSearchPlaceholder}"
                                   Foreground="#334155" FontSize="13"
                                   VerticalAlignment="Center" Margin="44,0,0,0"
                                   IsHitTestVisible="False" HorizontalAlignment="Left">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Category filter -->
                    <ComboBox Grid.Column="1" Margin="8,0,4,0"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              VerticalAlignment="Center"/>

                    <!-- Action filter -->
                    <ComboBox Grid.Column="2" Margin="4,0,0,0"
                              ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedAction}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ========== MAIN CONTENT ========== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== SIDEBAR ===== -->
                <Border Background="#0D1320" BorderBrush="#1E3054" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Sidebar header -->
                        <Border DockPanel.Dock="Top" Padding="12,10"
                                BorderBrush="#1E3054" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding LblFileSystem}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#475569" FontFamily="Consolas"/>
                        </Border>

                        <!-- Drive tree — lazy expanding -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TreeView ItemsSource="{Binding DriveNodes}"
                                      Padding="4,4"
                                      Background="Transparent"
                                      BorderThickness="0">
                                <TreeView.Resources>
                                    <!-- Dark theme for TreeView toggle button -->
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="Padding" Value="2,2"/>
                                        <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#111E33"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1D3461"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TreeView.Resources>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="Segoe UI" FontSize="12"
                                                   Foreground="#94A3B8"
                                                   Cursor="Hand"
                                                   MouseLeftButtonDown="FolderNode_Click"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="1"
                              Background="#1E3054" HorizontalAlignment="Stretch"/>

                <!-- ===== MAIN PANEL ===== -->
                <Grid Grid.Column="2">

                    <!-- TIMELINE VIEW -->
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource StrEqToVis}, ConverterParameter=Timeline}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,10"
                                    BorderBrush="#1E3054" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LblLiveTimeline}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#475569" FontFamily="Consolas"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#0F2040" CornerRadius="4"
                                                Padding="8,3" Margin="12,0">
                                            <TextBlock FontSize="11" Foreground="#60A5FA" FontFamily="Consolas">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}{1}">
                                                        <Binding Path="LblTodayPrefix"/>
                                                        <Binding Path="TodayEvents"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding LblRecording}" FontSize="10" Foreground="#4ADE80"
                                                   VerticalAlignment="Center" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scroll locked banner -->
                            <Border DockPanel.Dock="Top"
                                    Background="#1A2E50" Padding="16,8"
                                    BorderBrush="#2D4A7A" BorderThickness="0,0,0,1"
                                    Cursor="Hand"
                                    Visibility="{Binding IsScrollLocked, Converter={StaticResource BoolToVis}}"
                                    MouseLeftButtonDown="ResumeLiveButton_Click">
                                <TextBlock Text="{Binding LblScrollLocked}"
                                           Foreground="#60A5FA" FontSize="11"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <ListBox x:Name="TimelineListBox"
                                     ItemsSource="{Binding LiveEvents}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,4"
                                     FocusVisualStyle="{x:Null}"
                                     Loaded="TimelineListBox_Loaded">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="EventRow"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="0,0,0,1"
                                                Padding="16,8"
                                                Cursor="Hand"
                                                ToolTip="Click to open location in Explorer"
                                                MouseEnter="EventRow_MouseEnter"
                                                MouseLeave="EventRow_MouseLeave"
                                                MouseLeftButtonDown="EventRow_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           Foreground="#334155" FontSize="11"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CategoryIcon}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <Border Grid.Column="2" Margin="4,0"
                                                        CornerRadius="4" Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Background="#0F1E30">
                                                    <TextBlock Text="{Binding Action}"
                                                               FontSize="10" FontFamily="Consolas"
                                                               Foreground="{Binding ActionColor, Converter={StaticResource StrToColor}}"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding ProcessName}"
                                                           Foreground="#60A5FA" FontSize="12"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding ProcessName, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Details}"
                                                           Foreground="#94A3B8" FontSize="12"
                                                           FontFamily="Segoe UI"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- SEARCH / RESULTS VIEW -->
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource StrEqToVis}, ConverterParameter=Search}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,10"
                                    BorderBrush="#1E3054" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LblSearchResults}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#475569" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    <Border Background="#0F2040" CornerRadius="4"
                                            Padding="8,3" Margin="12,0">
                                        <TextBlock FontSize="11" Foreground="#60A5FA" FontFamily="Consolas">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}{1}">
                                                    <Binding Path="SearchResults.Count"/>
                                                    <Binding Path="LblMatches"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding LblSearching}" Foreground="#FBBF24"
                                               FontSize="11" FontFamily="Consolas"
                                               VerticalAlignment="Center" Margin="12,0"
                                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SearchResults}" Padding="0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent"
                                                    BorderBrush="#0D1831" BorderThickness="0,0,0,1"
                                                    Padding="16,8" Cursor="Hand"
                                                    ToolTip="Click to open location in Explorer"
                                                    MouseEnter="EventRow_MouseEnter"
                                                    MouseLeave="EventRow_MouseLeave"
                                                    MouseLeftButtonDown="EventRow_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeDisplay}"
                                                               Foreground="#334155" FontSize="11"
                                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CategoryIcon}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <Border Grid.Column="2" Margin="4,0" CornerRadius="4"
                                                            Padding="6,2" VerticalAlignment="Center"
                                                            Background="#0F1E30">
                                                        <TextBlock Text="{Binding Action}"
                                                                   FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{Binding ActionColor, Converter={StaticResource StrToColor}}"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding ProcessName}"
                                                               Foreground="#60A5FA" FontSize="12"
                                                               FontFamily="Consolas" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding ProcessName, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Details}"
                                                               Foreground="#94A3B8" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- FOLDER VIEW -->
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource StrEqToVis}, ConverterParameter=Folder}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,10"
                                    BorderBrush="#1E3054" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedFolderPath}"
                                                   Foreground="#94A3B8" FontFamily="Consolas"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="500"
                                                   ToolTip="{Binding SelectedFolderPath}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding OpenFolderCommand}"
                                            CommandParameter="{Binding SelectedFolderPath}"
                                            ToolTip="Open this location in Windows Explorer">
                                        <TextBlock Text="{Binding LblOpenExplorer}" FontSize="11"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SearchResults}" Padding="0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent"
                                                    BorderBrush="#0D1831" BorderThickness="0,0,0,1"
                                                    Padding="16,8"
                                                    Cursor="Hand"
                                                    ToolTip="Click to open location in Explorer"
                                                    MouseEnter="EventRow_MouseEnter"
                                                    MouseLeave="EventRow_MouseLeave"
                                                    MouseLeftButtonDown="EventRow_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeDisplay}"
                                                               Foreground="#334155" FontSize="11"
                                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CategoryIcon}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <Border Grid.Column="2" Margin="4,0" CornerRadius="4"
                                                            Padding="6,2" VerticalAlignment="Center"
                                                            Background="#0F1E30">
                                                        <TextBlock Text="{Binding Action}" FontSize="10"
                                                                   FontFamily="Consolas" FontWeight="SemiBold"
                                                                   Foreground="{Binding ActionColor, Converter={StaticResource StrToColor}}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding ProcessName}"
                                                               Foreground="#60A5FA" FontSize="12"
                                                               FontFamily="Consolas" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding ProcessName, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Details}"
                                                               Foreground="#94A3B8" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FilePath}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- NOISE FILTER / PROCESS ACTIVITY VIEW -->
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource StrEqToVis}, ConverterParameter=NoiseFilter}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,10"
                                    BorderBrush="#1E3054" BorderThickness="0,0,0,1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding LblNoiseFilterTitle}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#475569" FontFamily="Consolas"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#2D1A10" CornerRadius="4"
                                                Padding="8,3" Margin="12,0">
                                            <TextBlock Text="Игнорируемые процессы исключены из таймлайна / Ignored = hidden from timeline"
                                                       FontSize="10" Foreground="#FB923C" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ClearAllEventsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑 " FontSize="12"/>
                                            <TextBlock Text="{Binding LblClearAll}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Column header -->
                            <Border DockPanel.Dock="Top" Padding="16,6"
                                    Background="#0A1020"
                                    BorderBrush="#1E3054" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PROCESS" Foreground="#475569" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="TOTAL" Foreground="#475569" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="CREATE" Foreground="#475569" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="MODIFY" Foreground="#475569" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="DELETE" Foreground="#475569" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="ACTIONS" Foreground="#475569" FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ProcessActivityStats}" Padding="0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ProcessActivityStat}">
                                            <Border Padding="16,9"
                                                    BorderBrush="#0D1831" BorderThickness="0,0,0,1"
                                                    MouseEnter="EventRow_MouseEnter"
                                                    MouseLeave="EventRow_MouseLeave">
                                                <Border.Background>
                                                    <SolidColorBrush Color="Transparent"/>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Process name + ignored badge -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}"
                                                                   Foreground="#94A3B8" FontSize="12"
                                                                   FontFamily="Consolas"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="#3B1E10" CornerRadius="3"
                                                                Padding="5,1" Margin="8,0,0,0"
                                                                Visibility="{Binding IsIgnored, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="IGNORED" Foreground="#FB923C"
                                                                       FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Total -->
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalEvents}"
                                                               Foreground="#F1F5F9" FontSize="12"
                                                               FontFamily="Consolas" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <!-- Created -->
                                                    <TextBlock Grid.Column="2" Text="{Binding CreatedCount}"
                                                               Foreground="#4ADE80" FontSize="12"
                                                               FontFamily="Consolas"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <!-- Modified -->
                                                    <TextBlock Grid.Column="3" Text="{Binding ModifiedCount}"
                                                               Foreground="#60A5FA" FontSize="12"
                                                               FontFamily="Consolas"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <!-- Deleted -->
                                                    <TextBlock Grid.Column="4" Text="{Binding DeletedCount}"
                                                               Foreground="#F87171" FontSize="12"
                                                               FontFamily="Consolas"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- Toggle Ignore -->
                                                        <Button Margin="2,0"
                                                                Command="{Binding DataContext.ToggleIgnoreProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding ProcessName}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="#1E3054"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="#2D4A7A"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Padding" Value="6,3"/>
                                                                    <Setter Property="FontSize" Value="10"/>
                                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#2D1A10"/>
                                                                                        <Setter Property="BorderBrush" Value="#FB923C"/>
                                                                                        <Setter Property="Foreground" Value="#FB923C"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                                                <Setter Property="Text" Value="✓ Show"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsIgnored}" Value="False">
                                                                                <Setter Property="Text" Value="🔇 Ignore"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>

                                                        <!-- Clear events -->
                                                        <Button Margin="2,0"
                                                                Command="{Binding DataContext.ClearProcessEventsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding ProcessName}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="#1A1020"/>
                                                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Setter Property="BorderBrush" Value="#3B1040"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Padding" Value="6,3"/>
                                                                    <Setter Property="FontSize" Value="10"/>
                                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="#3B1040"/>
                                                                                        <Setter Property="BorderBrush" Value="#A855F7"/>
                                                                                        <Setter Property="Foreground" Value="#A855F7"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="🗑 Clear"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- DASHBOARD VIEW -->
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource StrEqToVis}, ConverterParameter=Dashboard}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="DASHBOARD" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#475569" FontFamily="Consolas"
                                           Margin="0,0,0,20"/>

                                <UniformGrid Columns="3" Margin="0,0,0,20">
                                    <Border Background="#0D1320" CornerRadius="10"
                                            BorderBrush="#1E3054" BorderThickness="1"
                                            Padding="20,16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL EVENTS" FontSize="9"
                                                       Foreground="#475569" FontFamily="Consolas"/>
                                            <TextBlock Text="{Binding TotalEvents, StringFormat='{}{0:N0}'}"
                                                       FontSize="28" FontWeight="Bold"
                                                       Foreground="#F1F5F9" FontFamily="Consolas"/>
                                            <TextBlock Text="all time" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0D1320" CornerRadius="10"
                                            BorderBrush="#1E3054" BorderThickness="1"
                                            Padding="20,16" Margin="5,0">
                                        <StackPanel>
                                            <TextBlock Text="TODAY" FontSize="9"
                                                       Foreground="#475569" FontFamily="Consolas"/>
                                            <TextBlock Text="{Binding TodayEvents, StringFormat='{}{0:N0}'}"
                                                       FontSize="28" FontWeight="Bold"
                                                       Foreground="#4ADE80" FontFamily="Consolas"/>
                                            <TextBlock Text="events recorded" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0D1320" CornerRadius="10"
                                            BorderBrush="#1E3054" BorderThickness="1"
                                            Padding="20,16" Margin="10,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="STATUS" FontSize="9"
                                                       Foreground="#475569" FontFamily="Consolas"/>
                                            <TextBlock Text="● ACTIVE" FontSize="22" FontWeight="Bold"
                                                       Foreground="#4ADE80" FontFamily="Consolas"/>
                                            <TextBlock Text="monitoring all drives" FontSize="11" Foreground="#334155"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#0D1320" CornerRadius="10"
                                        BorderBrush="#1E3054" BorderThickness="1"
                                        Padding="20,16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVITY BY CATEGORY — TODAY"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#475569" FontFamily="Consolas"
                                                   Margin="0,0,0,16"/>
                                        <ItemsControl ItemsSource="{Binding ActivityStats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ActivityStat}">
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="50"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="#94A3B8" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="8"
                                                                CornerRadius="4" Background="#0F1E30"
                                                                Margin="0,0,12,0">
                                                            <Border CornerRadius="4" HorizontalAlignment="Left"
                                                                    Width="{Binding Percentage, Converter={StaticResource PctToWidth}}"
                                                                    Background="{Binding Color, Converter={StaticResource StrToColor}}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Count}"
                                                                   Foreground="#60A5FA"
                                                                   FontFamily="Consolas" FontSize="12"
                                                                   HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0D1320" CornerRadius="10"
                                        BorderBrush="#1E3054" BorderThickness="1"
                                        Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="TOP ACTIVE PROCESSES — TODAY"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#475569" FontFamily="Consolas"
                                                   Margin="0,0,0,16"/>
                                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#1E3054" BorderThickness="0,0,0,1"
                                                            Padding="0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="60"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       Foreground="#94A3B8"
                                                                       FontFamily="Consolas" FontSize="12"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Count}"
                                                                       Foreground="#FBBF24"
                                                                       FontFamily="Consolas" FontSize="12"
                                                                       HorizontalAlignment="Right"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ========== STATUS BAR ========== -->
            <Border Grid.Row="3" Background="#080C14"
                    BorderBrush="#1E3054" BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#4ADE80" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#475569" FontSize="11"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="#334155" FontSize="10" FontFamily="Consolas"
                               Text="EventTracker v2.0  |  SQLite  |  FileSystemWatcher"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
